     1                                  ; Variante educativa del bucle contado: calcula 5! = 120.
     2                                  ; Compilación en DOSBox: NASM -f bin DOS\LAB6FAC.ASM -o DOS\LAB6FAC.COM
     3                                  BITS 16
     4                                  ORG 100h
     5                                  
     6                                  inicio:
     7 00000000 B80100                      mov ax, 1             ; acumulador del producto
     8 00000003 BB0100                      mov bx, 1             ; multiplicador inicial
     9 00000006 B90500                      mov cx, 5             ; cinco factores: 1, 2, 3, 4 y 5
    10                                  .factor:
    11 00000009 F7E3                        mul bx                ; DX:AX = AX * BX; el resultado final cabe en AX
    12 0000000B 43                          inc bx
    13 0000000C E2FB                        loop .factor
    14 0000000E CD20                        int 20h
